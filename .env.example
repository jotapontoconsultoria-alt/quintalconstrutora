# Copie para .env e preencha.
# Endereço do painel (o DNS deste endereço precisa apontar para o IP do VPS).
DOMINIO=obras.seudominio.com.br
# Primeiro administrador: criado automaticamente no primeiro acesso, enquanto não houver nenhum usuário.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_SENHA=troque-por-uma-senha-forte

# Só se o VPS já tem nginx usando as portas 80/443 (outro site): descomente a linha abaixo.
# COMPOSE_FILE=docker-compose.nginx.yml
